<!--
    The editor area: the editor screen, its panels and the project screens.

    Keys shared by several screens in this file keep one prefix per group
    (`editor_`, `panel_`, `projects_`, `home_`, `nav_`) so the same verb cannot
    drift apart between screens. Keys that already exist in strings_settings.xml
    (`action_back`, `action_close`, `settings_title`, `diagnostics_*`) are
    referenced, not duplicated.
-->
