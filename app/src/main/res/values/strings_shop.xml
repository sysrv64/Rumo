<?xml version="1.0" encoding="utf-8"?>
<!--
  The shop: the section switcher, the repository browser and the Google Fonts
  list. Only text the user reads is here. Comparison keys, repository topics,
  catalogue category tokens and log messages stay in the data layer on purpose —
  translating one of those would break a comparison without a compile error.

  The one coupling worth naming: `ShopUpdates.NO_RELEASE` is compared against
  the literal `GitHubApi.fail("no suitable release")` produces. Neither side can
  move into a resource.
-->
<resources>

    <!-- Shop screen: the title bar, the section switcher and its subtitles. -->
    <string name="shop_title">Shop</string>
    <string name="shop_section_fonts">Fonts</string>
    <string name="shop_section_templates">Templates</string>
    <string name="shop_section_effects">Effects</string>
    <string name="shop_settings">Shop settings</string>
    <string name="shop_updates_available"> Updates available</string>
    <!-- %1$d — how many updates are waiting. -->
    <plurals name="shop_updates_count">
        <item quantity="one">%1$d update</item>
        <item quantity="other">%1$d updates</item>
    </plurals>
    <!-- %1$s — name, %2$s — installed version, %3$s — available version. -->
    <string name="shop_update_line">%1$s: %2$s → %3$s</string>

    <!-- Shop settings dialog. -->
    <string name="shop_settings_token_hint">Fonts come from Google Fonts and need no token. Templates and effects are read through the GitHub API, where a token raises the limit from 60 requests an hour to 5000.</string>
    <string name="shop_settings_token_label">GitHub token</string>
    <string name="shop_settings_check_updates">Check for updates</string>
    <string name="shop_settings_preview_fonts">Preview fonts in the list</string>
    <string name="shop_settings_show_builtins">Show the built-in templates</string>
    <string name="shop_settings_interval">Hours between update checks</string>
    <!-- %1$s — comma-separated family names. -->
    <string name="shop_settings_installed_fonts">Installed fonts: %1$s</string>
    <string name="shop_cancel">Cancel</string>

    <!-- Shop screen: the subtitle under the title. -->
    <!-- %1$d — how many families the catalogue holds. -->
    <plurals name="shop_fonts_subtitle_none">
        <item quantity="one">%1$d family · nothing installed</item>
        <item quantity="other">%1$d families · nothing installed</item>
    </plurals>
    <!-- %1$d — families in the catalogue, %2$d — installed. -->
    <plurals name="shop_fonts_subtitle_installed">
        <item quantity="one">%1$d family · %2$d installed</item>
        <item quantity="other">%1$d families · %2$d installed</item>
    </plurals>
    <string name="shop_fonts_subtitle_loading">Reading the Google Fonts catalogue…</string>

    <!-- Repository browser: subtitles and list chrome. -->
    <string name="shop_repos_subtitle_no_token">a GitHub token is required</string>
    <string name="shop_repos_subtitle_loading">Checking repositories…</string>
    <!-- %1$s — the repository topic, an API value that is never translated. -->
    <string name="shop_repos_subtitle_none">no repository carries %1$s yet</string>
    <!-- %1$d — how many repositories the search returned. -->
    <plurals name="shop_repos_subtitle_count">
        <item quantity="one">%1$d repository</item>
        <item quantity="other">%1$d repositories</item>
    </plurals>
    <string name="shop_repos_filter">Filter repositories</string>
    <string name="shop_repos_builtin">Built-in</string>
    <string name="shop_repos_token_title">GitHub token required</string>
    <string name="shop_repos_token_message">Templates and effects are read through the GitHub API. Without a token GitHub allows 60 requests an hour, which is not enough to check a list of repositories. Fonts do not need it.</string>
    <string name="shop_repos_token_action">Add a token</string>
    <string name="shop_repos_checking_title">Checking repositories</string>
